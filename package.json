{
  "name": "shuyin-diary",
  "version": "0.1.0",
  "description": "个人日记本桌面应用 (Electron + React + TypeScript)",
  "main": "dist/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "typecheck:renderer": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p tsconfig.json && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "concurrently -k -n renderer,main,electron \"vite\" \"npm run watch:main\" \"wait-on tcp:5173 dist/main/index.js && cross-env NODE_ENV=development electron .\"",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  }
}
